---
import BaseLayout from "../layouts/BaseLayout.astro";

const skills = [
  "PHP", "MySQL", "JavaScript", "Python", "Tailwind CSS",
  "HTML5", "CSS3", "REST APIs", "Authentication", "CRUD",
  "Admin Dashboards", "Student Portals / LMS"
];

const projects = [
  {
    number: "01",
    type: "Ministry website · Learning portal",
    title: "Immanuel USA",
    description: "A ministry website and online learning experience supporting free Bible courses, student registration, course access and assignment workflows.",
    stack: ["PHP", "MySQL", "JavaScript", "HTML / CSS"],
    link: "https://immanuelusa.org/",
    linkText: "Visit website"
  },
  {
    number: "02",
    type: "Web application · In development",
    title: "AuditForge",
    description: "A web-based concept for structured website and digital-business audits, designed to present findings in a clear, client-friendly format.",
    stack: ["Astro", "Tailwind CSS", "Firebase"],
    link: "https://auditforge-e62e6.web.app/",
    linkText: "View project"
  },
  {
    number: "03",
    type: "Learning management",
    title: "Student Learning Portal",
    description: "Student-facing learning workflows including registration, account access, course content and assignment submission. Presented as part of the Immanuel USA platform.",
    stack: ["PHP", "MySQL", "JavaScript"],
    link: "https://immanuelusa.org/",
    linkText: "View platform"
  }
];
---
<BaseLayout>
  <header class="site-header">
    <nav class="nav wrap" aria-label="Main navigation">
      <a class="brand" href="#home" aria-label="Mohammed Nazzer home"><span class="brand-mark">MN</span><span>Mohammed Nazzer</span></a>
      <div class="nav-links">
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#experience">Experience</a>
        <a class="nav-contact" href="#contact">Contact <span aria-hidden="true">↗</span></a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero wrap" id="home">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> AVAILABLE FOR SELECT OPPORTUNITIES</div>
        <h1>Building useful<br /><span>digital experiences.</span></h1>
        <p class="hero-lead">I'm <strong>Mohammed Nazzer</strong>, a freelance Full-Stack Developer focused on building responsive websites, web applications and practical business tools.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projects">Explore my work <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="mailto:mnazzer@gmail.com">Get in touch</a>
        </div>
        <div class="hero-meta">
          <span><span class="meta-icon">⌘</span> PHP · MySQL · JavaScript · Python</span>
          <span><span class="meta-icon">◎</span> Based in the UAE</span>
        </div>
      </div>
      <div class="hero-art" aria-label="Abstract code illustration">
        <div class="art-glow"></div>
        <div class="code-window">
          <div class="window-top"><div class="window-dots"><i></i><i></i><i></i></div><span>developer.js</span><span class="window-menu">•••</span></div>
          <div class="code-lines">
            <div><span class="line-no">01</span><span class="code-purple">const</span> developer = &#123;</div>
            <div><span class="line-no">02</span>&nbsp;&nbsp;name: <span class="code-green">'Mohammed'</span>,</div>
            <div><span class="line-no">03</span>&nbsp;&nbsp;role: <span class="code-green">'Full-Stack Developer'</span>,</div>
            <div><span class="line-no">04</span>&nbsp;&nbsp;build: [</div>
            <div><span class="line-no">05</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="code-green">'Websites'</span>,</div>
            <div><span class="line-no">06</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="code-green">'Web Apps'</span>,</div>
            <div><span class="line-no">07</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="code-green">'Digital Tools'</span></div>
            <div><span class="line-no">08</span>&nbsp;&nbsp;]</div>
            <div><span class="line-no">09</span>&#125;;<span class="cursor"></span></div>
          </div>
          <div class="code-footer"><span><b></b> Ready to build</span><span>UTF-8&nbsp;&nbsp; JavaScript</span></div>
        </div>
        <div class="floating-chip chip-one"><span>✳</span> Clean code</div>
        <div class="floating-chip chip-two"><span>↗</span> User-focused</div>
      </div>
      <a class="scroll-cue" href="#about"><span></span> SCROLL TO EXPLORE</a>
    </section>

    <section class="intro-strip">
      <div class="wrap strip-inner">
        <p>Turning ideas into <strong>reliable web solutions.</strong></p>
        <div class="strip-tags"><span>DEVELOPMENT</span><span>·</span><span>PROBLEM SOLVING</span><span>·</span><span>CONTINUOUS LEARNING</span></div>
      </div>
    </section>

    <section class="section wrap" id="about">
      <div class="section-label"><span>01</span> ABOUT ME</div>
      <div class="about-grid">
        <div><h2>Developer mindset.<br /><span>Practical outcomes.</span></h2></div>
        <div class="about-content">
          <p class="large-copy">I enjoy creating digital products that make everyday work simpler — from public-facing websites to database-driven portals and admin dashboards.</p>
          <p>Since February 2021, I have worked as a freelance Full-Stack Developer, building and improving web solutions with a focus on functionality, usability and maintainable code. I work across both front-end interfaces and back-end systems, and I value clear communication throughout a project.</p>
          <a class="text-link" href="mailto:mnazzer@gmail.com">Let's discuss a project <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="section skills-section" id="skills">
      <div class="wrap">
        <div class="section-label"><span>02</span> TOOLKIT</div>
        <div class="section-heading-row"><h2>Skills &amp; technologies</h2><p>Tools I use to design, develop<br />and deliver web solutions.</p></div>
        <div class="skills-grid">
          {skills.map((skill, index) => <div class="skill-card"><span class="skill-index">{String(index + 1).padStart(2, "0")}</span><span>{skill}</span><span class="skill-arrow">↗</span></div>)}
        </div>
      </div>
    </section>

    <section class="section wrap" id="projects">
      <div class="section-label"><span>03</span> SELECTED WORK</div>
      <div class="section-heading-row"><h2>Projects with purpose.</h2><p>A selection of web platforms and<br />digital products I have worked on.</p></div>
      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-top"><span class="project-number">{project.number}</span><span class="project-type">{project.type}</span><span class="project-symbol">↗</span></div>
            <div class="project-visual">
              {project.number === "01" ? <div class="mock-browser"><div class="mock-bar"><i></i><i></i><i></i><span>immanuelusa.org</span></div><div class="mock-content"><div class="mock-logo">IMMANUEL <small>USA</small></div><div class="mock-title">Biblical learning.<br /><em>Made accessible.</em></div><div class="mock-lines"><i></i><i></i></div><div class="mock-button"></div></div></div> :
              project.number === "02" ? <div class="audit-visual"><div class="audit-orbit orbit-a"></div><div class="audit-orbit orbit-b"></div><div class="audit-center">A<span>F</span></div><div class="audit-caption">DIGITAL EXPERIENCE AUDIT</div></div> :
              <div class="portal-visual"><div class="portal-side"><b>MN</b><i></i><i></i><i></i><i></i></div><div class="portal-main"><span>STUDENT DASHBOARD</span><b>Welcome back</b><div class="portal-boxes"><i></i><i></i><i></i></div><div class="portal-row"></div><div class="portal-row short"></div></div></div>}
            </div>
            <div class="project-info"><h3>{project.title}</h3><p>{project.description}</p><div class="tag-list">{project.stack.map(tag => <span>{tag}</span>)}</div><a class="project-link" href={project.link} target="_blank" rel="noreferrer">{project.linkText} <span>↗</span></a></div>
          </article>
        ))}
      </div>
      <p class="project-note">Project descriptions are concise portfolio summaries. Add repository links, screenshots and any additional client work only where you have permission to share them.</p>
    </section>

    <section class="section experience-section" id="experience">
      <div class="wrap">
        <div class="section-label"><span>04</span> EXPERIENCE &amp; EDUCATION</div>
        <div class="timeline-grid">
          <div><h2>Experience that<br /><span>keeps evolving.</span></h2></div>
          <div class="timeline">
            <article class="timeline-item"><div class="timeline-date">FEB 2021 — PRESENT</div><div><h3>Freelance Full-Stack Developer</h3><p class="timeline-place">Independent / Client Projects</p><p>Developing and maintaining websites and web applications, including database-backed portals, authentication, admin dashboards and responsive user interfaces.</p><div class="tag-list"><span>PHP</span><span>MySQL</span><span>JavaScript</span><span>Python</span></div></div></article>
            <article class="timeline-item"><div class="timeline-date">2023</div><div><h3>Master's in Biblical Studies</h3><p class="timeline-place">University of Christian Studies and Seminary</p><p>Completed in 2023.</p></div></article>
            <article class="timeline-item"><div class="timeline-date">2019</div><div><h3>Associate Degree in Business Administration</h3><p class="timeline-place">University of the People</p><p>Completed in 2019.</p></div></article>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-section" id="contact">
      <div class="wrap contact-inner">
        <div class="section-label light-label"><span>05</span> GET IN TOUCH</div>
        <p class="contact-kicker">HAVE A PROJECT OR OPPORTUNITY?</p>
        <h2>Let's build something<br /><em>that matters.</em></h2>
        <a class="contact-email" href="mailto:mnazzer@gmail.com">mnazzer@gmail.com <span>↗</span></a>
        <div class="contact-bottom"><span>UAE · OPEN TO REMOTE OPPORTUNITIES</span><div><a href="https://github.com/mohammednazzer5-ui" target="_blank" rel="noreferrer">GitHub ↗</a><a href="mailto:mnazzer@gmail.com">Email ↗</a></div></div>
      </div>
    </section>
  </main>

  <footer class="footer"><div class="wrap footer-inner"><a class="brand" href="#home"><span class="brand-mark">MN</span><span>Mohammed Nazzer</span></a><span>© {new Date().getFullYear()} Mohammed Nazzer. Built with care.</span><a href="#home">BACK TO TOP ↑</a></div></footer>
</BaseLayout>

